tip = "The Assassin joins! Hit the Ogre from behind: the violet arc of its ring.\nThe Goblin's full ring means any side counts. Backstab from behind adds Marks.\nMarks auto-parry for the Assassin and make Execute cheaper."

[sub_resource type="Resource" id="Round_7"]
script = ExtResource("2_encounter")
title = "Round 7"
arena = ExtResource("a_square")
party = Array[PackedScene]([ExtResource("c_monk"), ExtResource("c_cleric")])
enemies = Array[PackedScene]([ExtResource("c_goblin_fighter"), ExtResource("c_ogre_warrior")])
tip = "The Monk joins! Knee Smash climbs his bar a step: 30, 50, 80, then 100.\nAll-Perfect Arts leave tokens; at the top, Crowd Cheer opens Tortoise Special.\nProvoke the Ogre and Parry it for Rush; Suplex counters a strike."

