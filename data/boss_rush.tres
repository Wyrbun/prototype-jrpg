party = Array[PackedScene]([ExtResource("c_knight"), ExtResource("c_archer"), ExtResource("c_mage"), ExtResource("c_cleric")])
enemies = Array[PackedScene]([ExtResource("c_gale_maw")])
tip = "The Gale Maw never moves: it breathes. Inhale pulls you toward its mouth, Exhale blows you toward the drop.\nHide behind a rock to shelter from its breath. Defend shortens any push or pull.\nGo over the edge and you can Parry to catch yourself, but you're Off-Balance for 3 turns after.\nIts blasts crack the rocks (two cracks and one shatters for a while), and at half HP the cliff edge crumbles closer."

