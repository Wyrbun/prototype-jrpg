# Copy this file to ".env" (same folder) and fill in the values.
# .env is ignored by git: never commit your keys.

# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Your server's ID (Discord: Settings -> Advanced -> Developer Mode on,
# then right-click the server icon -> Copy Server ID).
# With it, /ask shows up in that server right away.
GUILD_ID=

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# CLAUDE_MODEL=claude-haiku-5-5
# COOLDOWN_SECONDS=30
# DAILY_LIMIT=200
# ASK_CHANNEL_ID=        (only answer /ask in this channel; empty = anywhere)
